{
  "name": "rovloom",
  "version": "0.6.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Rovloom: multi-machine MCP gateway and connector for Luvus/Herdr runtimes",
  "type": "module",
  "bin": {
    "rovloom": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun --no-env-file scripts/bun/build.mjs",
    "release:build": "bun --no-env-file scripts/release/build.mjs",
    "release:smoke": "bun --no-env-file scripts/release/smoke.mjs",
    "e2e": "bun --no-env-file e2e/run.mjs",
    "typecheck": "bun --no-env-file node_modules/typescript/bin/tsc --noEmit",
    "test": "bun --no-env-file test ./test",
    "smoke": "bun --no-env-file scripts/bun/smoke.mjs",
    "lint": "bun --no-env-file node_modules/oxlint/bin/oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives-severity error src test scripts e2e site",
    "lint:fix": "bun --no-env-file run lint --fix",
    "format": "bun --no-env-file node_modules/oxfmt/bin/oxfmt --config .oxfmtrc.json --write \"{src,test,scripts,e2e,site}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "bun --no-env-file node_modules/oxfmt/bin/oxfmt --config .oxfmtrc.json --check \"{src,test,scripts,e2e,site}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "audit:luvus": "bun --no-env-file scripts/luvus/audit-fixtures.mjs",
    "test:protocol": "bun --no-env-file test ./test/luvus ./test/mcp/sdk-compatibility.test.mjs",
    "test:toolchain": "bun --no-env-file test ./test/toolchain/compatibility.test.mjs",
    "site:build": "bun --no-env-file scripts/site/build.mjs",
    "site:dev": "bun --no-env-file scripts/site/dev.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  }
}
